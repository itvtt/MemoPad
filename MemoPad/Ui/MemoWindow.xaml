<Window x:Class="MemoPad.Ui.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MemoPad" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        MinWidth="150" MinHeight="30" Width="260" Height="180"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True"
        FontFamily="Segoe UI, Malgun Gothic">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="WindowChromeInfo" CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- 메모 위의 작은 단추: 바탕은 메모 색, 아이콘은 어두운 반투명 -->
        <Style x:Key="MemoButton" TargetType="Button">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Foreground" Value="#B3000000" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#1A000000" />
                                <Setter Property="Foreground" Value="#E6000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#29000000" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MemoToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Foreground" Value="#B3000000" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#1A000000" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#33000000" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InkToolStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Width="16" Height="16" Stroke="Transparent" StrokeThickness="2" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#40000000" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#B3000000" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 머리의 제목 고치기 칸 (F2 · 메뉴 → 제목 바꾸기) -->
        <Style x:Key="TitleEditorStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6000000" />
            <Setter Property="CaretBrush" Value="#E6000000" />
            <Setter Property="SelectionBrush" Value="#663B82F6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#1A000000" BorderBrush="#66000000" BorderThickness="0,0,0,1" CornerRadius="3,3,0,0" Padding="1,2,1,1">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Paragraph"><Setter Property="Margin" Value="0" /></Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="#FFF4A8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 머리: 메뉴 · 제목 · 상태 아이콘 · 항상 위 · 삭제 잠금 · 접기 · 버리기 -->
        <Border x:Name="Header" Grid.Row="0" Height="24" Background="#0F000000" Padding="2,0,2,0"
                MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseRightButtonUp="Header_MouseRightButtonUp">
            <DockPanel LastChildFill="True">
                <Button x:Name="MenuButton" DockPanel.Dock="Left" Style="{StaticResource MemoButton}" Content="&#xE700;" ToolTip="메뉴" Click="MenuButton_Click" />
                <StackPanel x:Name="HeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PinButton" Style="{StaticResource MemoButton}" Content="&#xE718;" ToolTip="항상 위" Click="PinButton_Click" />
                    <Button x:Name="DeleteLockButton" Style="{StaticResource MemoButton}" Content="&#xE785;" ToolTip="삭제 잠그기" Click="DeleteLockButton_Click" />
                    <Button x:Name="CollapseButton" Style="{StaticResource MemoButton}" Content="&#xE921;" ToolTip="접기 (제목 두 번 클릭)" Click="CollapseButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource MemoButton}" Content="&#xE8BB;" ToolTip="버리기 (Alt+F4)" Click="CloseButton_Click"
                            ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
                <StackPanel x:Name="StateIcons" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,2,0" VerticalAlignment="Center"
                            TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="9" TextElement.Foreground="#8C000000" />
                <Grid Margin="4,0,4,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontSize="11.5" Foreground="#99000000" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="TitleEditor" Style="{StaticResource TitleEditorStyle}" MaxLength="60" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 본문 -->
        <RichTextBox x:Name="Editor" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="8,4,6,4"
                     Foreground="#FF1F2124" CaretBrush="#FF1F2124" SelectionBrush="#663B82F6" AcceptsTab="True"
                     VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}"
                     SpellCheck.IsEnabled="False" IsDocumentEnabled="True" AutoWordSelection="False" />
        <Border x:Name="InkHost" Grid.Row="1" Visibility="Collapsed" ClipToBounds="True">
            <InkCanvas x:Name="Ink" Background="Transparent">
                <InkCanvas.LayoutTransform><ScaleTransform x:Name="InkZoom" ScaleX="1" ScaleY="1" /></InkCanvas.LayoutTransform>
            </InkCanvas>
        </Border>
        <Border x:Name="SecureCover" Grid.Row="1" Visibility="Collapsed" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="SecureCover_MouseLeftButtonUp">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#99000000" HorizontalAlignment="Center" />
                <TextBlock Margin="0,6,0,0" Text="보안 메모" FontSize="12" Foreground="#99000000" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 첨부 -->
        <WrapPanel x:Name="AttachmentPanel" Grid.Row="2" Margin="6,0,6,4" Visibility="Collapsed" />

        <!-- 그림 도구 -->
        <Border x:Name="InkBar" Grid.Row="3" Visibility="Collapsed" Background="#0F000000" Padding="4,2">
            <WrapPanel x:Name="InkTools" VerticalAlignment="Center" />
        </Border>

        <!-- 상태줄 -->
        <Border x:Name="StatusBar" Grid.Row="4" Visibility="Collapsed" Padding="8,2,14,3">
            <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="#8C000000" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- 접은 메모: 메모 색의 작은 사각형 (정음 메모패드처럼) + 왼쪽에 제목(없으면 본문 첫 줄).
             두 번 클릭 = 펼치기, 끌기 = 옮기기, 오른쪽 클릭 = 메뉴 -->
        <DockPanel x:Name="CollapsedFace" Grid.RowSpan="5" Visibility="Collapsed" Background="Transparent"
                   ToolTipService.InitialShowDelay="300"
                   MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseRightButtonUp="Header_MouseRightButtonUp">
            <Viewbox DockPanel.Dock="Right" Width="24" Height="24" Stretch="Uniform">
                <Grid Width="24" Height="24">
                    <Path x:Name="FaceLines" Data="M 5.5,7.5 H 15.5 M 5.5,11.5 H 17 M 5.5,15.5 H 11.5" Stroke="#6B000000" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="FaceFold" Data="M 16,24 L 24,16 L 24,24 Z" Fill="#2E000000" />
                    <TextBlock x:Name="FaceGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,1" Visibility="Collapsed"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#99000000" />
                </Grid>
            </Viewbox>
            <TextBlock x:Name="FaceText" Margin="8,0,0,1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#D9000000"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
