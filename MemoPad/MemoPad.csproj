<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 릴리스 버전의 바닥값: Actions 러너는 마지막 릴리스의 다음 번호를 고름 -->
    <Version>1.0.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘 (NotifyIcon) · 글꼴 · 색 고르기. WinForms 이름이 WPF 와 겹치지 않게 아래에서 전역 using 을 뺌 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MemoPad</RootNamespace>
    <AssemblyName>MemoPad</AssemblyName>
    <ApplicationIcon>Assets\MemoPad.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>MemoPad</AssemblyTitle>
    <Product>MemoPad</Product>
    <Description>바탕화면 메모 · 메모 주고받기 · 회람 · 대화 (정음 메모패드와 주고받기)</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="MemoPad.Checks" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\MemoPad.ico" />
    <Resource Include="Assets\MemoPad.png" />
    <None Remove="Assets\Build-Icon.ps1" />
  </ItemGroup>

  <!-- i-luncher AppKit: 자체 업데이트(update.json)와 릴리스 zip -->
  <Import Project="AppKit\AppKit.targets" />
</Project>
